{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gameillion",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gameillion",
      // Replace with the id printed by: npx wrangler d1 create gameillion
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
    { "name": "EMAIL_LIMITER", "namespace_id": "2003", "simple": { "limit": 5, "period": 60 } },
    { "name": "CHECKOUT_LIMITER", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } }
  ],
  // Public settings. Secrets (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, RESEND_API_KEY)
  // are added in the Cloudflare dashboard, never here.
  "vars": {
    "ADMIN_EMAILS": "",
    "EMAIL_FROM": ""
  },
  "observability": { "enabled": true }
}
